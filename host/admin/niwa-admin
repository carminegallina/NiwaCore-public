#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="/home/niwa/niwa"
IMPORT_SOURCE="${PROJECT_ROOT}/host/import-service"
IMPORT_TARGET="/opt/niwa-import"
HOTSPOT_CONNECTION="Hotspot"
# Shared with the NIWA System container, which may only write "request" here.
HOTSPOT_DIR="${PROJECT_ROOT}/data/hotspot"

usage() {
  cat <<'EOF'
Usage: sudo niwa-admin <command> [argument]

Commands:
  import-install
  import-restart
  import-status
  hotspot-up
  hotspot-channel <1|6|11>
  hotspot-request
  hotspot-scan
  service-restart <service>
  service-status <service>

Allowed services:
  niwa-import.service
  docker.service
  tailscaled.service
  smbd.service
  nmbd.service
  NetworkManager.service
EOF
}

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo "niwa-admin must run through sudo." >&2
    exit 1
  fi
}

require_file() {
  local path="$1"
  if [[ ! -f "${path}" ]]; then
    echo "Required file not found: ${path}" >&2
    exit 1
  fi
}

validate_service() {
  case "${1:-}" in
    niwa-import.service|docker.service|tailscaled.service|smbd.service|nmbd.service|NetworkManager.service)
      ;;
    *)
      echo "Service is not allowed: ${1:-<missing>}" >&2
      exit 1
      ;;
  esac
}

install_import_service() {
  require_file "${IMPORT_SOURCE}/niwa_import.py"
  require_file "${IMPORT_SOURCE}/static/niwa-logo.png"
  require_file "${IMPORT_SOURCE}/niwa-import.service"

  install -d -m 0755 "${IMPORT_TARGET}"
  install -d -m 0755 "${IMPORT_TARGET}/static"
  install -d -m 0755 /mnt/niwa-import
  install -d -m 0755 /mnt/niwa-storage/.niwa_import_staging
  install -d -m 0755 /mnt/niwa-storage/.niwa_bridge_staging
  install -m 0755 "${IMPORT_SOURCE}/niwa_import.py" "${IMPORT_TARGET}/niwa_import.py"
  install -m 0644 "${IMPORT_SOURCE}/static/niwa-logo.png" "${IMPORT_TARGET}/static/niwa-logo.png"
  install -m 0644 "${IMPORT_SOURCE}/niwa-import.service" /etc/systemd/system/niwa-import.service
  systemctl daemon-reload
  systemctl enable niwa-import.service
  systemctl restart niwa-import.service
  systemctl --no-pager status niwa-import.service
}

hotspot_channel_now() {
  nmcli -g 802-11-wireless.channel connection show "${HOTSPOT_CONNECTION}"
}

# Written through a fresh temp file and a rename, so a symlink planted in the
# shared folder is replaced instead of followed.
write_hotspot_status() {
  local ok="$1" message="$2" tmp
  install -d -m 0755 "${HOTSPOT_DIR}"
  tmp="$(mktemp "${HOTSPOT_DIR}/.status.XXXXXX")"
  printf '{"channel":"%s","ok":%s,"message":"%s","updated":"%s"}
'     "$(hotspot_channel_now)" "${ok}" "${message}" "$(date -Iseconds)" > "${tmp}"
  chmod 0644 "${tmp}"
  mv -fT "${tmp}" "${HOTSPOT_DIR}/status.json"
}

set_hotspot_channel() {
  local channel="$1" previous
  case "${channel}" in
    1|6|11) ;;
    *)
      echo "Hotspot channel must be 1, 6 or 11." >&2
      return 1
      ;;
  esac
  previous="$(hotspot_channel_now)"
  if [[ "${previous}" == "${channel}" ]]; then
    write_hotspot_status true "Canale ${channel} gia' attivo"
    return 0
  fi
  if ! nmcli connection modify "${HOTSPOT_CONNECTION}" 802-11-wireless.band bg 802-11-wireless.channel "${channel}"; then
    write_hotspot_status false "Impossibile impostare il canale ${channel}"
    return 1
  fi
  if nmcli connection up "${HOTSPOT_CONNECTION}"; then
    write_hotspot_status true "Canale ${channel} attivo"
    return 0
  fi
  # Never leave an event without Wi-Fi: go back to the channel that worked.
  nmcli connection modify "${HOTSPOT_CONNECTION}" 802-11-wireless.channel "${previous}" || true
  nmcli connection up "${HOTSPOT_CONNECTION}" || true
  write_hotspot_status false "Canale ${channel} non attivato, ripristinato ${previous}"
  return 1
}

# Only numbers leave this function: 2.4 GHz channels and signal levels, no
# network names. Scanning while the hotspot is up needs `ap-force`.
scan_hotspot_neighbours() {
  local tmp networks
  install -d -m 0755 "${HOTSPOT_DIR}"
  tmp="$(mktemp "${HOTSPOT_DIR}/.scan.XXXXXX")"
  if networks="$(timeout 25 iw dev wlan0 scan ap-force | awk '
      function emit() {
        if (freq >= 2412 && freq <= 2484 && signal != "") {
          printf "%s{\"channel\":%d,\"signal\":%.1f}", (count++ ? "," : ""), (freq == 2484 ? 14 : (freq - 2407) / 5), signal
        }
      }
      /^BSS / { emit(); freq = 0; signal = "" }
      $1 == "freq:" { freq = int($2) }
      $1 == "signal:" { signal = $2 + 0 }
      END { emit() }')"; then
    printf '{"ok":true,"message":"Scansione completata","networks":[%s],"updated":"%s"}
'       "${networks}" "$(date -Iseconds)" > "${tmp}"
  else
    printf '{"ok":false,"message":"Il Wi-Fi del Raspberry non riesce a scansionare mentre fa da hotspot","networks":[],"updated":"%s"}
'       "$(date -Iseconds)" > "${tmp}"
  fi
  chmod 0644 "${tmp}"
  mv -fT "${tmp}" "${HOTSPOT_DIR}/scan.json"
}

# Run by niwa-hotspot.service when NIWA System drops a request file.
apply_hotspot_request() {
  local request="${HOTSPOT_DIR}/request" value=""
  if [[ ! -e "${request}" && ! -L "${request}" ]]; then
    write_hotspot_status true "Stato aggiornato"
    return 0
  fi
  # The container wrote this file: read a few bytes of a regular file only.
  if [[ -f "${request}" && ! -L "${request}" ]]; then
    value="$(timeout 2 head -c 4 -- "${request}" | tr -dc 'a-z0-9' || true)"
  fi
  rm -rf -- "${request}"
  case "${value}" in
    1|6|11)
      set_hotspot_channel "${value}"
      ;;
    scan)
      scan_hotspot_neighbours
      ;;
    *)
      write_hotspot_status false "Richiesta non valida"
      return 1
      ;;
  esac
}

require_root

case "${1:-}" in
  import-install)
    install_import_service
    ;;
  import-restart)
    systemctl restart niwa-import.service
    systemctl --no-pager status niwa-import.service
    ;;
  import-status)
    systemctl --no-pager status niwa-import.service
    ;;
  hotspot-up)
    nmcli connection up Hotspot
    ;;
  hotspot-channel)
    set_hotspot_channel "${2:-}"
    ;;
  hotspot-request)
    apply_hotspot_request
    ;;
  hotspot-scan)
    scan_hotspot_neighbours
    ;;
  service-restart)
    validate_service "${2:-}"
    systemctl restart "$2"
    systemctl --no-pager status "$2"
    ;;
  service-status)
    validate_service "${2:-}"
    systemctl --no-pager status "$2"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
